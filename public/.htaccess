<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Never hand the HTML front controller back for a missing static asset.
    # Serving the SPA shell for a missing JS/CSS module makes the browser abort
    # with "Failed to load module script ... MIME type text/html".
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule \.(?:js|mjs|css|map|woff2?|ttf|eot|otf|svg|png|jpe?g|gif|ico|webp|avif)$ - [R=404,L]

    # Handle Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On

    # Fingerprinted build assets - safe to cache for a year
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"

    # Images are not fingerprinted (logos, favicons) - always revalidate
    ExpiresByType image/png "access plus 0 seconds"
    ExpiresByType image/jpeg "access plus 0 seconds"
    ExpiresByType image/gif "access plus 0 seconds"
    ExpiresByType image/svg+xml "access plus 0 seconds"
    ExpiresByType image/webp "access plus 0 seconds"
    ExpiresByType image/x-icon "access plus 0 seconds"

    # The HTML shell must not be cached
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # Blocks Search Engine Indexing
    Header set X-Robots-Tag "noindex, nofollow"

    # The HTML shell (usually rendered through index.php) must never be cached,
    # otherwise a deploy keeps the browser pointing at old fingerprinted chunks.
    <FilesMatch "\.(?:html?|php)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    </FilesMatch>
</IfModule>
